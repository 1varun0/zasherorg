---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products } from '../data/products';
const product = products.find(p => p.id === 'productivity');
---

<BaseLayout 
  title="Productivity — Zasher" 
  description={product?.description || ''}
>
  <header class="hero" style={`--accent: var(--amber);`}>
    <div class="wrap">


      <h1>
        <span class="anim-hero-line" style="display:inline-block;">{product?.name}</span>
      </h1>
      <p class="hero-sub anim-hero-sub">{product?.description}</p>
    </div>
  </header>

  <section class="products">
    <div class="wrap">
      <div class="section-head reveal-on-scroll">
        <h2>Features</h2>
      </div>
      <div class="grid">
        <div class="card reveal-on-scroll" style="--accent-line: rgba(214,162,76,0.4);">
          <div class="glyph" style="background:var(--amber-dim); color:var(--amber);">01</div>
          <h3>Focus Blocks</h3>
          <p>Schedule deep work sessions directly in your timeline. Defend your time before it's taken.</p>
        </div>
        <div class="card reveal-on-scroll" style="--accent-line: rgba(214,162,76,0.4);">
          <div class="glyph" style="background:var(--amber-dim); color:var(--amber);">02</div>
          <h3>Priority Triage</h3>
          <p>Not everything is urgent. Separate what must happen today from what can wait until tomorrow.</p>
        </div>
        <div class="card reveal-on-scroll" style="--accent-line: rgba(214,162,76,0.4);">
          <div class="glyph" style="background:var(--amber-dim); color:var(--amber);">03</div>
          <h3>Reality Check</h3>
          <p>The app gently warns you when you've scheduled more hours of work than there are in a day.</p>
        </div>
      </div>

      <div class="reveal-on-scroll" style="margin-top:80px;">
        <h2 style="font-family:'Fraunces', serif; font-size:34px; font-weight:600; margin-bottom:24px;">How it works</h2>
        <div style="display:flex; flex-direction:column; gap:24px;">
          <p><strong>1. Brain dump.</strong> Get everything out of your head and into the inbox.</p>
          <p><strong>2. Assign.</strong> Drag tasks into your daily timeline or snooze them.</p>
          <p><strong>3. Execute.</strong> Focus on one thing at a time with the built-in timer.</p>
        </div>
        
        <div style="margin-top:56px;">
          <a href="https://productivity-eta-six.vercel.app/" target="_blank" rel="noopener noreferrer" style="display:inline-block; background:var(--amber); color:var(--ink); padding:16px 32px; border-radius:4px; font-weight:500;">Try Productivity</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
