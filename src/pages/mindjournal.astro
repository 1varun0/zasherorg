---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products } from '../data/products';
const product = products.find(p => p.id === 'mindjournal');
---

<BaseLayout 
  title="Mindjournal — Zasher" 
  description={product?.description || ''}
>
  <header class="hero" style={`--accent: var(--sage);`}>
    <div class="wrap">


      <h1>
        <span class="anim-hero-line" style="display:inline-block;">{product?.name}</span>
      </h1>
      <p class="hero-sub anim-hero-sub">{product?.description}</p>
    </div>
  </header>

  <section class="products">
    <div class="wrap">
      <div class="section-head reveal-on-scroll">
        <h2>Features</h2>
      </div>
      <div class="grid">
        <div class="card reveal-on-scroll" style="--accent-line: rgba(143,174,139,0.4);">
          <div class="glyph" style="background:var(--sage-dim); color:var(--sage);">01</div>
          <h3>Blank Canvas</h3>
          <p>No forced prompts, no mood tracking emojis. Just a clean editor that respects your focus.</p>
        </div>
        <div class="card reveal-on-scroll" style="--accent-line: rgba(143,174,139,0.4);">
          <div class="glyph" style="background:var(--sage-dim); color:var(--sage);">02</div>
          <h3>Guilt-Free</h3>
          <p>We don't do streaks. Write when you need to, don't when you don't. Your journal shouldn't be a chore.</p>
        </div>
        <div class="card reveal-on-scroll" style="--accent-line: rgba(143,174,139,0.4);">
          <div class="glyph" style="background:var(--sage-dim); color:var(--sage);">03</div>
          <h3>Local First</h3>
          <p>Your thoughts belong to you. Mindjournal stores everything on your device by default.</p>
        </div>
      </div>

      <div class="reveal-on-scroll" style="margin-top:80px;">
        <h2 style="font-family:'Fraunces', serif; font-size:34px; font-weight:600; margin-bottom:24px;">How it works</h2>
        <div style="display:flex; flex-direction:column; gap:24px;">
          <p><strong>1. Open.</strong> The app launches directly into today's blank page. No dashboard.</p>
          <p><strong>2. Write.</strong> Markdown supported. Autosaved instantly.</p>
          <p><strong>3. Review.</strong> Look back at past entries through a simple timeline view.</p>
        </div>
        
        <div style="margin-top:56px;">
          <a href="#" style="display:inline-block; background:var(--sage); color:var(--ink); padding:16px 32px; border-radius:4px; font-weight:500;">Try Mindjournal</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
